config_version=5

[application]
config/name="AFTERHOURS"
config/icon="res://assets/afterhours_icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/description="A first-person psychological horror game set inside an abandoned shopping mall."
boot_splash/show_image=false
boot_splash/bg_color=Color(0.018, 0.023, 0.028, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
scaling_3d/scale=0.85
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_roughness_limiter_enabled=true
environment/defaults/default_clear_color=Color(0.012, 0.014, 0.018, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
flashlight={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
objectives={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
